                "--adaptive-input-factor", "2",
                "--adaptive-softmax-factor", "2",
                "--log-interval", "1",
                "--adaptive-softmax-dropout", "0.0",
                "--dropout", "0.0",
                "--attention-dropout", "0.0",
                "--activation-dropout", "0.0",
