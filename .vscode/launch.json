                "--max-lr", "1.0",
                "--t-mult", "2",
                "--lr-period-updates", "270000",
                "--lr-scheduler", "cosine",
                "--lr-shrink", "0.75",
                "--warmup-updates", "16000",
                "--warmup-init-lr", "1e-07",
                "--min-lr", "1e-09",
                "--optimizer", "nag",
                "--lr", "0.0001",
                "--clip-norm", "0.1",
                "--criterion", "adaptive_loss",
                "--seed", "1",
                "--sample-break-mode", "none",
                "--skip-invalid-size-inputs-valid-test",
                "--ddp-backend", "no_c10d",
                "--max-tokens", "3072",
                "--tokens-per-sample", "3072",
                // Changed
                "--log-format", "json",
                "--update-freq", "1",
                "--max-tokens", "3072",
                "--tokens-per-sample", "3072",
                "--decoder-layers", "0",
                "--decoder-embed-dim", "64",
