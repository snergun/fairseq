{
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },

        {
            "name": "Python Debugger: Training Adaptive Inputs",
            "type": "debugpy",
            "python": "/opt/conda/envs/fairseq/bin/python",
            "request": "launch",
            "program": "train.py",
            "console": "integratedTerminal",
            "args": [
                "data/wikitext-103",
                "--task", "language_modeling",
                "--save-dir", "checkpoints/adaptive_inputs/",
                "--arch", "transformer_lm_wiki103",
                "--max-update", "286000",
                "--max-lr", "1.0",
                "--t-mult", "2",
                "--lr-period-updates", "270000",
                "--lr-scheduler", "cosine",
                "--lr-shrink", "0.75",
                "--warmup-updates", "16000",
                "--warmup-init-lr", "1e-07",
                "--min-lr", "1e-09",
                "--optimizer", "nag",
                "--lr", "0.0001",
                "--clip-norm", "0.1",
                "--criterion", "adaptive_loss",
                "--max-tokens", "3072",
                "--update-freq", "3",
                "--seed", "1",
                "--sample-break-mode", "none",
                "--skip-invalid-size-inputs-valid-test",
                "--ddp-backend", "no_c10d",
                "--tokens-per-sample", "3072",
            ],
            "cwd": "${workspaceFolder}"
        },
               {
            "name": "Python Debugger: Training Dummy Model",
            "type": "debugpy",
            "python": "/opt/conda/envs/fairseq/bin/python",
            "request": "launch",
            "program": "train.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "data/wikitext-103",
                "--task", "language_modeling",
                "--save-dir", "checkpoints/dummy_model/",
